"""
Base de données BaraChap en Python (SQLite : aucun serveur à installer).

Utilisation :
    python database.py          -> crée barachap.db et fait un petit test

Pour hacher les mots de passe avec bcrypt :
    pip install bcrypt
(si bcrypt n'est pas installé, le script utilise PBKDF2 de la bibliothèque standard)
"""

import sqlite3
import hashlib
import os
import hmac
from datetime import datetime

DB_FILE = "barachap.db"

try:
    import bcrypt:
except ImportError:
    bcrypt = None


# ---------- Connexion ----------
def get_connection():
    conn = sqlite3.connect(DB_FILE)
    conn.row_factory = sqlite3.Row          # accès aux colonnes par nom
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


# ---------- Création des tables ----------
def init_db():
    with get_connection() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                id            INTEGER PRIMARY KEY AUTOINCREMENT,
                nom           TEXT NOT NULL,
                prenom        TEXT NOT NULL,
                email         TEXT NOT NULL UNIQUE,
                metier        TEXT NOT NULL,
                telephone     TEXT NOT NULL,
                mot_de_passe  TEXT NOT NULL,   -- hash, jamais le mot de passe en clair
                role          TEXT NOT NULL DEFAULT 'candidat'
                              CHECK (role IN ('candidat', 'admin')),
                created_at    TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
                last_login    TEXT DEFAULT NULL
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_email ON users(email)")


# ---------- Hachage du mot de passe ----------
def hash_password(password: str) -> str:
    if bcrypt:
        return bcrypt.hashpw(password.encode(), bcrypt.gensalt()).decode()
    salt = os.urandom(16)
    dk = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 200_000)
    return f"pbkdf2${salt.hex()}${dk.hex()}"


def verify_password(password: str, stored: str) -> bool:
    if stored.startswith("pbkdf2$"):
        _, salt_hex, dk_hex = stored.split("$")
        dk = hashlib.pbkdf2_hmac("sha256", password.encode(),
                                 bytes.fromhex(salt_hex), 200_000)
        return hmac.compare_digest(dk.hex(), dk_hex)
    return bcrypt.checkpw(password.encode(), stored.encode())


# ---------- Inscription ----------
def register_user(nom, prenom, email, metier, telephone, password, role="candidat"):
    """Retourne l'id du nouvel utilisateur, ou None si l'email existe déjà."""
    try:
        with get_connection() as conn:
            cur = conn.execute(
                """INSERT INTO users (nom, prenom, email, metier, telephone, mot_de_passe, role)
                   VALUES (?, ?, ?, ?, ?, ?, ?)""",
                (nom, prenom, email.lower().strip(), metier, telephone,
                 hash_password(password), role),
            )
            return cur.lastrowid
    except sqlite3.IntegrityError:
        return None


# ---------- Connexion ----------
def login_user(email, password):
    """Retourne l'utilisateur (dict) si identifiants corrects, sinon None."""
    with get_connection() as conn:
        user = conn.execute(
            "SELECT * FROM users WHERE email = ?", (email.lower().strip(),)
        ).fetchone()
        if user and verify_password(password, user["mot_de_passe"]):
            conn.execute(
                "UPDATE users SET last_login = ? WHERE id = ?",
                (datetime.now().isoformat(timespec="seconds"), user["id"]),
            )
            return {k: user[k] for k in user.keys() if k != "mot_de_passe"}
    return None


# ---------- Test ----------
if __name__ == "__main__":
    init_db()
    print("Base créée :", DB_FILE)

    uid = register_user("Dedo Coton", "Steve", "steve@example.com",
                        "Développeur web", "+2250700000000", "MotDePasse123")
    print("Inscription :", "OK, id =" if uid else "email déjà utilisé", uid or "")

    print("Connexion correcte :", login_user("steve@example.com", "MotDePasse123") is not None)
    print("Connexion erronée  :", login_user("steve@example.com", "mauvais") is not None)